PORT=3000

# ── Primary Chat Models (Flowise) ──────────────────────────────────────────────
MODEL_1_NAME="Vector GPT"
MODEL_1_ID="YOUR_CHATFLOW_ID_1"
MODEL_1_HOST="https://your-flowise.hf.space"
# MODEL_1_API_KEY="YOUR_FLOWISE_API_KEY"

MODEL_2_NAME="Vector Research"
MODEL_2_ID="YOUR_CHATFLOW_ID_2"
MODEL_2_HOST="https://your-flowise.hf.space"

# ── Dedicated Labs model (Flowise) — used by the legacy /labs-edit endpoints ──
LABS_MODEL_NAME="Vector Editor"
LABS_MODEL_ID="YOUR_LABS_CHATFLOW_ID"
LABS_MODEL_HOST="https://your-flowise.hf.space"

# ── Labs v2 agent editor (direct Gemini via AI SDK) ──────────────────────────
# Google AI Studio API key used by Chat and Labs (Gemini and Gemma)
GEMINI_API_KEY=your_google_ai_studio_api_key
# Add as many numbered models as needed. Both Chat and Labs show this list.
GEMINI_MODEL_1_ID=gemini-3.5-flash-lite
GEMINI_MODEL_1_NAME="Gemini Flash Lite"
GEMINI_MODEL_1_THINKING_LEVEL=medium
GEMINI_MODEL_2_ID=gemma-4-31b-it
GEMINI_MODEL_2_NAME="Gemma 31B"
GEMINI_MODEL_2_THINKING_LEVEL=high
# Default selections; the UI can switch models without clearing chat/documents.
GEMINI_MODEL=gemini-3.5-flash-lite
LABS_LLM_MODEL=gemini-3.5-flash-lite
LABS_LLM_THINKING_LEVEL=medium
# Thinking options are model-specific and appear beside the model selector.
# Gemini 3/3.5 Flash: minimal, low, medium, high.
# Gemma 4: minimal (thinking disabled), high (thinking enabled).
# Gemini 3 Pro: low, high. Gemini 3.1 Pro: low, medium, high.
# Gemini 2.5: budget-based low, medium, high (Flash also supports off).
# Optional tuning (defaults shown):
# LABS_INLINE_DOC_CHARS=40000   # docs at or below this size are inlined in full (≈7 pages); larger docs switch to outline + read_blocks
# LABS_MAX_STEPS=20             # max agent loop steps per request
# LABS_MAX_EDITS=120            # max block edits across all batches and continuations (1-300)
# LABS_MAX_OUTPUT_TOKENS=16384   # per model response, including thinking (1024-65536)
# LABS_MAX_CONTINUATIONS=2      # bounded underlength draft continuations, sharing the step/edit budget (0-3)

# ── Optional: Flowise authentication ─────────────────────────────────────────
# FLOWISE_API_KEY=your_api_key

# DEBUG=true
